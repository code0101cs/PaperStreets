<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Backtest Result | Trading Backtester</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="dark">
  <button id="themeToggle" class="btn btn-outline theme-toggle">Switch to Light Mode</button>

  <div class="container" style="max-width: 1000px;">
    <h1>Backtest Result</h1>

    <div class="result-box">
      <div>
          <label>Stock</label>
          <p><strong><%= result.symbol %></strong></p>
      </div>
      <div>
          <label>Strategy</label>
          <p><strong><%= result.strategy %></strong></p>
      </div>
      <div>
          <label>Period</label>
          <p><strong><%= result.startDate %> — <%= result.endDate %></strong></p>
      </div>
      <div>
          <label>Initial Capital</label>
          <p><strong>$<%= result.results.initialCapital.toLocaleString() %></strong></p>
      </div>
      <div>
          <label>Final Portfolio</label>
          <p style="color: var(--accent-primary);"><strong>$<%= result.results.finalPortfolioValue.toLocaleString() %></strong></p>
      </div>
    </div>

    <div class="chart-box" style="margin-top: 40px;">
      <h2>Performance Visualizer</h2>
      <div class="chart-container">
        <canvas id="priceChart"></canvas>
      </div>
    </div>

    <h2 style="margin-top: 40px;">Comprehensive Trade Log</h2>

    <% if (result.results.trades.length === 0) { %>
      <p style="text-align: center; padding: 40px; color: var(--text-secondary);">No trades generated.</p>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 4px;">
          <% result.results.trades.forEach(trade => { %>
            <div class="trade-item">
              <div style="flex: 1;">
                  <span style="font-weight: 700; color: <%= trade.type === 'BUY' ? '#10b981' : '#ef4444' %>;"><%= trade.type %></span>
              </div>
              <div style="flex: 2;">
                  <span style="color: var(--text-secondary);"><%= trade.date %></span>
              </div>
              <div style="flex: 1; text-align: right;">
                  <span>$<%= trade.price.toLocaleString() %></span>
              </div>
              <% if (trade.profitLoss !== undefined) { %>
                <div style="flex: 1; text-align: right;">
                    <span style="font-weight: 600; color: <%= trade.profitLoss >= 0 ? '#10b981' : '#ef4444' %>;">
                        <%= trade.profitLoss >= 0 ? '+' : '' %><%= trade.profitLoss.toLocaleString() %>
                    </span>
                </div>
              <% } %>
            </div>
          <% }) %>
      </div>
    <% } %>

    <div class="nav-actions">
      <a href="/dashboard" class="btn btn-primary">Run Another Backtest</a>
      <a href="/dashboard" class="btn btn-secondary">Dashboard</a>
      <a href="/history" class="btn btn-outline">History</a>
      <a href="/logout" class="btn btn-outline">Logout</a>
    </div>
  </div>

  <script>
    const priceData = <%- JSON.stringify(result.priceData || []) %>;
    const signals = <%- JSON.stringify(result.signals || []) %>;

    if (priceData.length > 0) {
      const labels = priceData.map(item => item.date);
      const closePrices = priceData.map(item => Number(item.close));
      
      const buyPoints = priceData.map(item => {
        const found = signals.find(signal => signal.date === item.date && signal.signal === "BUY");
        return found ? item.close : null;
      });

      const sellPoints = priceData.map(item => {
        const found = signals.find(signal => signal.date === item.date && signal.signal === "SELL");
        return found ? item.close : null;
      });

      const ctx = document.getElementById("priceChart").getContext("2d");
      const isDark = document.body.classList.contains('dark');
      
      new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [
            {
              label: "Close Price",
              data: closePrices,
              borderColor: isDark ? '#38bdf8' : '#0284c7',
              borderWidth: 2,
              pointRadius: 0,
              tension: 0.1,
              fill: false
            },
            {
              label: "BUY",
              data: buyPoints,
              borderColor: "#10b981",
              backgroundColor: "#10b981",
              pointStyle: 'triangle',
              pointRadius: 8,
              showLine: false
            },
            {
              label: "SELL",
              data: sellPoints,
              borderColor: "#ef4444",
              backgroundColor: "#ef4444",
              pointStyle: 'triangle',
              rotation: 180,
              pointRadius: 8,
              showLine: false
            }
          ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: { grid: { color: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)' } },
                y: { grid: { color: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)' } }
            }
        }
      });
    }
  </script>
  <script src="/js/themeToggle.js"></script>
</body>
</html>