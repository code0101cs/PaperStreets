<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Trading Backtester</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container">
    <h1>Trading Backtester</h1>

    <form action="/backtest" method="POST" class="backtest-form">
      <input type="text" name="symbol" placeholder="Stock Symbol" required />
      <input type="date" name="startDate" required />
      <input type="date" name="endDate" required />
      <input type="number" name="capital" placeholder="Capital" required />

      <select name="strategy" required>
        <option value="">Select Strategy</option>
        <option value="moving-average">Moving Average Crossover</option>
        <option value="buy-hold">Buy and Hold</option>
      </select>

      <button type="submit">Run Backtest</button>
    </form>
  </div>
  <a href="/logout">Logout</a>
  <a href="/history">View Past Backtests</a>
</body>
</html>